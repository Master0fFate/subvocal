{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/codex-sessionstart.js\"",
            "timeout": 5,
            "statusMessage": "Loading subvocal mode"
          }
        ]
      }
    ]
  }
}
