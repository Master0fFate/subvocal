{
  "name": "subvocal",
  "version": "0.2.0",
  "description": "Fewer thinking tokens, same answers. One measured instruction keeps a model's internal reasoning concise; the reply is unchanged. `/subvocal ultra` asks for a minimum draft per thinking step.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Master0fFate/subvocal.git"
  },
  "homepage": "https://github.com/Master0fFate/subvocal#readme",
  "bugs": {
    "url": "https://github.com/Master0fFate/subvocal/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "copilot",
    "plugin",
    "hooks",
    "thinking-tokens",
    "reasoning",
    "shorthand"
  ],
  "bin": {
    "subvocal": "installer/install.js"
  },
  "files": [
    "installer/",
    "src/hooks/",
    "skills/",
    "LICENSE",
    "README.md",
    "INSTALL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "lexicon:measure": "python3 scripts/measure_tokens.py --backend claude-cli --model haiku",
    "lexicon:build": "python3 scripts/build_lexicon.py",
    "lexicon:check": "python3 scripts/build_lexicon.py --check",
    "eval": "python3 evals/run.py",
    "install:claude": "node installer/install.js"
  }
}
